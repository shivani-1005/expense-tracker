# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker"

# Secret used to sign/verify JWTs - use a long random string in production
JWT_SECRET="change-me"

# Port the Express server listens on (optional, defaults to 5001)
PORT=5001

# Set to "production" on Render so cookies get Secure + SameSite=None
NODE_ENV=development
